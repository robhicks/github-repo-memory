# GitHub OAuth App credentials
ECMEM_GITHUB_CLIENT_ID=your_client_id
ECMEM_GITHUB_CLIENT_SECRET=your_client_secret
ECMEM_GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback
ECMEM_GITHUB_ORG=your-org-name

# GitHub Enterprise (optional — defaults to github.com)
# ECMEM_GITHUB_API_URL=https://github.example.com/api/v3
# ECMEM_GITHUB_AUTH_URL=https://github.example.com/login/oauth/authorize
# ECMEM_GITHUB_TOKEN_URL=https://github.example.com/login/oauth/access_token

# FalkorDB connection
ECMEM_FALKORDB_HOST=127.0.0.1
ECMEM_FALKORDB_PORT=6379
# ECMEM_FALKORDB_PASSWORD=
ECMEM_FALKORDB_GRAPH=enterprise_code

# Server
ECMEM_SERVER_HOST=127.0.0.1
ECMEM_SERVER_PORT=8080

# Auth mode for MCP clients: "github" or "jwt"
ECMEM_AUTH_MODE=github
# ECMEM_JWT_SECRET=your-jwt-secret-here

# Sync settings
ECMEM_SYNC_BATCH_SIZE=50
ECMEM_MAX_FILE_DEPTH=2
